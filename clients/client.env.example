# client.env: the workstation's values for OpenCode, claude-local and the shell profile
# (docs/stack-design.md, section 6). It lives in ~/.config/local-agent-stack/client.env with mode
# 600, in a directory with mode 700, and never in a repository. Write it with
#   python3 tools/secrets.py gen client --share ~/.config/local-agent-stack/secrets/web.env \
#       --ask LOCAL_LLM_KEY -o ~/.config/local-agent-stack/client.env
# A shell reads this file: no spaces or quotes in the values.

# Your lab domain: the same value as LAB_DOMAIN in edge.env (and in web.env). OpenCode builds
# https://llm.<LAB_DOMAIN>/v1 and https://mcp.<LAB_DOMAIN>/servers/<name>/mcp from it.
# --share web.env copies it.
LAB_DOMAIN=lab.example.com

# The LiteLLM virtual key created for this workstation in chapter 4 of the guide (one key per
# workstation, allowed the local-* models this machine uses; never LITELLM_MASTER_KEY).
# --ask LOCAL_LLM_KEY prompts for it without echoing it.
LOCAL_LLM_KEY=sk-local-replace-with-your-litellm-virtual-key

# The MCP hub's bearer token: the same value as MCP_HUB_TOKEN in web.env (the hub has one token
# for every client). --share web.env copies it.
MCP_HUB_TOKEN=replace-with-the-mcp-hub-token
