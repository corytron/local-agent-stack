# Variables for the ai-inference app (stack/inference/compose.yaml; docs/stack-design.md §6).
# Copy to /mnt/tank/ai/secrets/inference.env (root-owned, mode 0600; never in git), or print one
# with random values: tools/secrets.py gen inference. Every value below is a placeholder.
# Use letters and digits only: the values go into a URL (DATABASE_URL) and HTTP headers.

# Admin key of the LiteLLM gateway (/ui login, /key/generate). Clients get virtual keys instead.
# LiteLLM refuses to start with an empty or known-unsafe master key.
LITELLM_MASTER_KEY=sk-local-change-me-litellm-master-key

# Encrypts credentials LiteLLM stores in its database. Never change it after the first start.
LITELLM_SALT_KEY=sk-local-change-me-litellm-salt-key

# Password of the litellm role in litellm-db (also used in LiteLLM's DATABASE_URL).
LITELLM_DB_PASSWORD=change-me-litellm-db-password

# Key llama-swap requires on every inference and /api route; known only to LiteLLM and admins.
LLAMA_SWAP_API_KEY=sk-local-change-me-llama-swap-key

# Optional: parent of models/ and appdata/ (default /mnt/tank/ai, docs/stack-design.md §4).
# AI_ROOT=/mnt/tank/ai
