# Variables for the ai-rag app (stack/rag/compose.yaml; docs/stack-design.md §6).
# Copy to /mnt/tank/ai/secrets/rag.env (root-owned, mode 0600; never in git), or print one with
# random values: tools/secrets.py gen rag. Every value below is a placeholder.
# Use letters and digits only (hyphens are fine): PG_PASSWORD goes into a URL (DATABASE_URL in
# web.env) and the keys go into HTTP headers.

# --- Generated secrets --------------------------------------------------------------------------

# Password of the openwebui role in pgvector. web.env must hold the same value. Read only when
# the database is created (first start); changing it later needs ALTER ROLE (see README.md).
PG_PASSWORD=change-me-pg-password

# Key docling-serve requires in the X-Api-Key header. web.env must hold the same value.
DOCLING_API_KEY=change-me-docling-api-key

# Optional: protects oikb's /sync and /history routes (ai-net only). Empty turns that off.
OIKB_API_KEY=change-me-oikb-api-key

# --- Set after Open WebUI's first start (ai-web) -------------------------------------------------

# API key of the dedicated "indexer" user in Open WebUI (Settings > Account > API keys), with
# write access to the knowledge base below. Until it is set, every sync fails with an error in
# oikb's log; nothing else is affected. Redeploy ai-rag after setting it.
OIKB_TOKEN=sk-local-placeholder-set-after-open-webui-first-start

# ID of the knowledge base oikb fills from the rag-docs dataset: create it in Open WebUI under
# Workspace > Knowledge and copy the ID from its URL. Empty keeps oikb idle (syncs fail).
OIKB_KB_ID=

# --- Optional ------------------------------------------------------------------------------------

# Parent of appdata/ and rag-docs/ (default /mnt/tank/ai, docs/stack-design.md §4).
# AI_ROOT=/mnt/tank/ai
