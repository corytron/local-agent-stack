# Variables for the ai-web app (stack/web/compose.yaml; docs/stack-design.md §6).
# Copy to /mnt/tank/ai/secrets/web.env (root-owned, mode 0600; never in git), or print one with
# random values: tools/secrets.py gen web. Every value below is a placeholder.
# Use letters and digits only (hyphens are fine): PG_PASSWORD goes into a URL (DATABASE_URL),
# the keys into HTTP headers, and MCP_HUB_TOKEN may only use A-Z a-z 0-9 - . _ ~ + /.

# --- Your domain ---------------------------------------------------------------------------------

# Same value as LAB_DOMAIN in edge.env. Open WebUI is served as https://chat.<LAB_DOMAIN> (its
# WEBUI_URL, the only origin it accepts) and SearXNG as https://search.<LAB_DOMAIN>.
LAB_DOMAIN=lab.example.com

# --- Generated secrets --------------------------------------------------------------------------

# Signs Open WebUI sessions and encrypts the tokens it stores. Never change it after the first
# start: every session ends and stored OAuth/MCP tokens can no longer be decrypted.
WEBUI_SECRET_KEY=change-me-webui-secret-key

# SearXNG's secret key (SearXNG refuses to start with its built-in default).
SEARXNG_SECRET=change-me-searxng-secret

# Bearer token of the MCP hub. The workstation's client.env holds the same value.
MCP_HUB_TOKEN=change-me-mcp-hub-token

# --- Copied from the other apps -----------------------------------------------------------------

# Same value as PG_PASSWORD in rag.env (Open WebUI's DATABASE_URL to pgvector).
PG_PASSWORD=change-me-pg-password

# Same value as DOCLING_API_KEY in rag.env (Open WebUI sends it to docling-serve).
DOCLING_API_KEY=change-me-docling-api-key

# A LiteLLM virtual key for Open WebUI, created after ai-inference is running (LiteLLM
# /key/generate with the master key). Allow at least the models local-coder, local-fast,
# local-coder-moe, local-embed and local-rerank: the same key serves chat, embeddings and
# reranking, and Open WebUI lists exactly the models it allows.
LITELLM_WEBUI_KEY=sk-local-change-me-litellm-webui-key

# --- Set after Open WebUI's first start ---------------------------------------------------------

# API key of the read-only "kb-reader" user in Open WebUI (Settings > Account > API keys), for
# the hub's kb server. Empty until then: the kb tools fail with an authentication error. Redeploy
# ai-web after setting it.
KB_READER_TOKEN=

# --- Optional ------------------------------------------------------------------------------------

# Contact address SearXNG sends to Wikipedia, Wikidata and OpenStreetMap (their API policies
# require one); a mailto: address or a web page. Empty leaves those three engines off.
SEARXNG_CONTACT_URL=mailto:admin@lab.example.com

# Parent of appdata/ (default /mnt/tank/ai, docs/stack-design.md §4).
# AI_ROOT=/mnt/tank/ai
