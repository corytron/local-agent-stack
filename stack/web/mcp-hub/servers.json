{
  "mcpServers": {
    "searxng": {
      "command": "/opt/mcp-hub/node_modules/.bin/mcp-searxng",
      "args": [],
      "env": {
        "SEARXNG_URL": "http://searxng:8080",
        "SEARXNG_MAX_RESULTS": "10",
        "SEARXNG_MAX_RESULT_CHARS": "500",
        "URL_READ_MAX_CHARS": "20000"
      }
    },
    "fetch": {
      "command": "/opt/mcp-hub/fetch/bin/mcp-server-fetch",
      "args": ["--no-readability-js"]
    },
    "kb": {
      "command": "/usr/local/bin/node",
      "args": [
        "--require",
        "/opt/mcp-hub/console-to-stderr.cjs",
        "/opt/mcp-hub/node_modules/open-webui-knowledge-mcp-server/dist/cli.js"
      ],
      "env": {
        "OPEN_WEBUI_API_URL": "http://open-webui:8080/api/v1"
      }
    }
  }
}
