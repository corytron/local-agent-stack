{"suite": "tools", "kind": "tools", "version": 1, "description": "Tool calling: single calls, parallel calls, no call needed, nested arguments and multi-turn, on the OpenAI chat route and the Anthropic messages route.", "system": "You are an assistant with tools. Call a tool when the request needs information or an action that one of the tools provides; otherwise answer directly. When several independent tool calls are needed, make all of them in the same turn. Follow the argument formats in the tool descriptions."}
{"id": "tools-001", "title": "single call, one required string", "api": "openai", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "What's the weather in Paris right now?"}], "expect": {"calls": [{"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^paris\\b"}, "unit": {"enum": ["celsius", "fahrenheit"]}}, "required": ["city"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "get_weather", "arguments": {"city": "Paris"}}]}}
{"id": "tools-002", "title": "single call with an enum argument", "api": "openai", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "How hot is it in Phoenix today? I want the temperature in Fahrenheit."}], "expect": {"calls": [{"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^phoenix\\b"}, "unit": {"const": "fahrenheit"}}, "required": ["city", "unit"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "get_weather", "arguments": {"city": "Phoenix", "unit": "fahrenheit"}}]}}
{"id": "tools-003", "title": "the right tool among four, integer line range", "api": "openai", "tools": [{"name": "search_files", "description": "Search the contents of the files under a directory for a regular expression and return the matching lines.", "parameters": {"type": "object", "properties": {"pattern": {"type": "string", "description": "Regular expression to search for"}, "path": {"type": "string", "description": "Directory to search (default: the current directory)"}, "max_results": {"type": "integer", "description": "Maximum number of matching lines to return"}}, "required": ["pattern"]}}, {"name": "read_file", "description": "Read a text file, or only a range of its lines (1-based, inclusive).", "parameters": {"type": "object", "properties": {"path": {"type": "string", "description": "Path of the file"}, "start_line": {"type": "integer", "description": "First line to return"}, "end_line": {"type": "integer", "description": "Last line to return"}}, "required": ["path"]}}, {"name": "run_command", "description": "Run a shell command on this workstation and return its output.", "parameters": {"type": "object", "properties": {"command": {"type": "string", "description": "The command line to run"}, "cwd": {"type": "string", "description": "Working directory"}, "timeout_s": {"type": "integer", "description": "Time limit in seconds"}}, "required": ["command"]}}, {"name": "web_search", "description": "Search the web and return result titles, URLs and snippets.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}, "max_results": {"type": "integer"}}, "required": ["query"]}}], "messages": [{"role": "user", "content": "Show me lines 10 to 25 of /srv/app/config.yaml."}], "expect": {"calls": [{"name": "read_file", "arguments": {"type": "object", "properties": {"path": {"const": "/srv/app/config.yaml"}, "start_line": {"const": 10}, "end_line": {"const": 25}}, "required": ["path", "start_line", "end_line"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "read_file", "arguments": {"path": "/srv/app/config.yaml", "start_line": 10, "end_line": 25}}]}}
{"id": "tools-004", "title": "optional arguments the request asks for", "api": "openai", "tools": [{"name": "search_files", "description": "Search the contents of the files under a directory for a regular expression and return the matching lines.", "parameters": {"type": "object", "properties": {"pattern": {"type": "string", "description": "Regular expression to search for"}, "path": {"type": "string", "description": "Directory to search (default: the current directory)"}, "max_results": {"type": "integer", "description": "Maximum number of matching lines to return"}}, "required": ["pattern"]}}, {"name": "read_file", "description": "Read a text file, or only a range of its lines (1-based, inclusive).", "parameters": {"type": "object", "properties": {"path": {"type": "string", "description": "Path of the file"}, "start_line": {"type": "integer", "description": "First line to return"}, "end_line": {"type": "integer", "description": "Last line to return"}}, "required": ["path"]}}], "messages": [{"role": "user", "content": "Find at most 5 lines that contain TODO in the files under the src directory."}], "expect": {"calls": [{"name": "search_files", "arguments": {"type": "object", "properties": {"pattern": {"type": "string", "pattern": "TODO"}, "path": {"type": "string", "pattern": "^(\\./)?src/?$"}, "max_results": {"const": 5}}, "required": ["pattern", "path", "max_results"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "search_files", "arguments": {"pattern": "TODO", "path": "src", "max_results": 5}}]}}
{"id": "tools-005", "title": "parallel calls of one tool", "api": "openai", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "extra_body": {"parallel_tool_calls": true}, "messages": [{"role": "user", "content": "Compare the current weather in Tokyo and in Oslo."}], "expect": {"calls": [{"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^tokyo\\b"}, "unit": {"enum": ["celsius", "fahrenheit"]}}, "required": ["city"], "additionalProperties": false}}, {"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^oslo\\b"}, "unit": {"enum": ["celsius", "fahrenheit"]}}, "required": ["city"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "get_weather", "arguments": {"city": "Oslo"}}, {"name": "get_weather", "arguments": {"city": "Tokyo"}}]}}
{"id": "tools-006", "title": "parallel calls of two different tools", "api": "openai", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}, {"name": "convert_currency", "description": "Convert an amount of money from one currency to another at today's rate.", "parameters": {"type": "object", "properties": {"amount": {"type": "number"}, "from_currency": {"type": "string", "description": "ISO 4217 code, for example USD"}, "to_currency": {"type": "string", "description": "ISO 4217 code, for example EUR"}}, "required": ["amount", "from_currency", "to_currency"]}}], "extra_body": {"parallel_tool_calls": true}, "messages": [{"role": "user", "content": "What's the weather in Madrid right now, and how much is 100 euros in US dollars?"}], "expect": {"calls": [{"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^madrid\\b"}, "unit": {"enum": ["celsius", "fahrenheit"]}}, "required": ["city"], "additionalProperties": false}}, {"name": "convert_currency", "arguments": {"type": "object", "properties": {"amount": {"type": "number", "const": 100}, "from_currency": {"type": "string", "pattern": "(?i)^eur$"}, "to_currency": {"type": "string", "pattern": "(?i)^usd$"}}, "required": ["amount", "from_currency", "to_currency"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "get_weather", "arguments": {"city": "Madrid"}}, {"name": "convert_currency", "arguments": {"amount": 100, "from_currency": "EUR", "to_currency": "USD"}}]}}
{"id": "tools-007", "title": "no call needed: arithmetic", "api": "openai", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}, {"name": "convert_currency", "description": "Convert an amount of money from one currency to another at today's rate.", "parameters": {"type": "object", "properties": {"amount": {"type": "number"}, "from_currency": {"type": "string", "description": "ISO 4217 code, for example USD"}, "to_currency": {"type": "string", "description": "ISO 4217 code, for example EUR"}}, "required": ["amount", "from_currency", "to_currency"]}}], "messages": [{"role": "user", "content": "What is 12 times 12? Answer with the number only."}], "expect": {"calls": [], "text": [{"check": "regex", "pattern": "\\b144\\b"}]}, "reference": {"calls": [], "text": "144"}}
{"id": "tools-008", "title": "no call needed: no tool fits the request", "api": "openai", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}, {"name": "convert_currency", "description": "Convert an amount of money from one currency to another at today's rate.", "parameters": {"type": "object", "properties": {"amount": {"type": "number"}, "from_currency": {"type": "string", "description": "ISO 4217 code, for example USD"}, "to_currency": {"type": "string", "description": "ISO 4217 code, for example EUR"}}, "required": ["amount", "from_currency", "to_currency"]}}], "messages": [{"role": "user", "content": "Translate 'good morning' into French."}], "expect": {"calls": [], "text": [{"check": "regex", "pattern": "(?i)bonjour"}]}, "reference": {"calls": [], "text": "Bonjour."}}
{"id": "tools-009", "title": "nested object and array of objects", "api": "openai", "tools": [{"name": "schedule_meeting", "description": "Schedule a meeting in the shared calendar.", "parameters": {"type": "object", "properties": {"title": {"type": "string"}, "start": {"type": "object", "properties": {"date": {"type": "string", "description": "YYYY-MM-DD"}, "time": {"type": "string", "description": "HH:MM, 24-hour clock"}}, "required": ["date", "time"]}, "duration_minutes": {"type": "integer"}, "attendees": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "email": {"type": "string"}}, "required": ["name", "email"]}}}, "required": ["title", "start", "duration_minutes", "attendees"]}}, {"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "Book a 45-minute meeting called 'Backup review' on 2026-12-03 at 14:30 with Ana Ruiz (ana@example.com) and Ben Okafor (ben@example.com)."}], "expect": {"calls": [{"name": "schedule_meeting", "arguments": {"type": "object", "properties": {"title": {"type": "string", "pattern": "(?i)^backup review$"}, "start": {"type": "object", "properties": {"date": {"const": "2026-12-03"}, "time": {"type": "string", "pattern": "^14:30(:00)?$"}}, "required": ["date", "time"], "additionalProperties": false}, "duration_minutes": {"const": 45}, "attendees": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "properties": {"name": {"type": "string"}, "email": {"type": "string"}}, "required": ["name", "email"]}, "allOf": [{"contains": {"type": "object", "properties": {"email": {"const": "ana@example.com"}}, "required": ["email"]}}, {"contains": {"type": "object", "properties": {"email": {"const": "ben@example.com"}}, "required": ["email"]}}]}}, "required": ["title", "start", "duration_minutes", "attendees"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "schedule_meeting", "arguments": {"title": "Backup review", "start": {"date": "2026-12-03", "time": "14:30"}, "duration_minutes": 45, "attendees": [{"name": "Ana Ruiz", "email": "ana@example.com"}, {"name": "Ben Okafor", "email": "ben@example.com"}]}}]}}
{"id": "tools-010", "title": "array of strings and an enum among several arguments", "api": "openai", "tools": [{"name": "create_issue", "description": "Create an issue in the project's issue tracker.", "parameters": {"type": "object", "properties": {"title": {"type": "string"}, "body": {"type": "string"}, "labels": {"type": "array", "items": {"type": "string"}}, "priority": {"type": "string", "enum": ["low", "medium", "high"]}}, "required": ["title"]}}, {"name": "search_files", "description": "Search the contents of the files under a directory for a regular expression and return the matching lines.", "parameters": {"type": "object", "properties": {"pattern": {"type": "string", "description": "Regular expression to search for"}, "path": {"type": "string", "description": "Directory to search (default: the current directory)"}, "max_results": {"type": "integer", "description": "Maximum number of matching lines to return"}}, "required": ["pattern"]}}], "messages": [{"role": "user", "content": "Open a high-priority issue titled 'Nightly backup fails on tank/ai' with the labels bug and backup. In the body, say that the backup job exits with code 2."}], "expect": {"calls": [{"name": "create_issue", "arguments": {"type": "object", "properties": {"title": {"type": "string", "pattern": "(?i)^nightly backup fails on tank/ai$"}, "body": {"type": "string", "pattern": "\\b2\\b"}, "labels": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2, "allOf": [{"contains": {"const": "bug"}}, {"contains": {"const": "backup"}}]}, "priority": {"const": "high"}}, "required": ["title", "body", "labels", "priority"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "create_issue", "arguments": {"title": "Nightly backup fails on tank/ai", "body": "The nightly backup job exits with code 2.", "labels": ["bug", "backup"], "priority": "high"}}]}}
{"id": "tools-011", "title": "multi-turn: the next call uses the previous tool result", "api": "openai", "tools": [{"name": "search_files", "description": "Search the contents of the files under a directory for a regular expression and return the matching lines.", "parameters": {"type": "object", "properties": {"pattern": {"type": "string", "description": "Regular expression to search for"}, "path": {"type": "string", "description": "Directory to search (default: the current directory)"}, "max_results": {"type": "integer", "description": "Maximum number of matching lines to return"}}, "required": ["pattern"]}}, {"name": "read_file", "description": "Read a text file, or only a range of its lines (1-based, inclusive).", "parameters": {"type": "object", "properties": {"path": {"type": "string", "description": "Path of the file"}, "start_line": {"type": "integer", "description": "First line to return"}, "end_line": {"type": "integer", "description": "Last line to return"}}, "required": ["path"]}}], "messages": [{"role": "user", "content": "Which file defines the function load_settings? Then show me that whole file."}, {"role": "assistant", "content": "", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "search_files", "arguments": "{\"pattern\": \"def load_settings\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "src/app/settings.py:14:def load_settings(path):"}], "expect": {"calls": [{"name": "read_file", "arguments": {"type": "object", "properties": {"path": {"type": "string", "pattern": "^(\\./)?src/app/settings\\.py$"}}, "required": ["path"]}}]}, "reference": {"calls": [{"name": "read_file", "arguments": {"path": "src/app/settings.py"}}]}}
{"id": "tools-012", "title": "multi-turn: answer from the tool result without a new call", "api": "openai", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "What's the weather in Lisbon?"}, {"role": "assistant", "content": "", "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": "{\"city\": \"Lisbon\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "{\"city\": \"Lisbon\", \"temperature_c\": 18, \"condition\": \"light rain\"}"}], "expect": {"calls": [], "text": [{"check": "regex", "pattern": "\\b18\\b"}, {"check": "regex", "pattern": "(?i)rain"}]}, "reference": {"calls": [], "text": "It is 18 °C in Lisbon with light rain."}}
{"id": "tools-013", "title": "a decimal number argument", "api": "openai", "tools": [{"name": "convert_currency", "description": "Convert an amount of money from one currency to another at today's rate.", "parameters": {"type": "object", "properties": {"amount": {"type": "number"}, "from_currency": {"type": "string", "description": "ISO 4217 code, for example USD"}, "to_currency": {"type": "string", "description": "ISO 4217 code, for example EUR"}}, "required": ["amount", "from_currency", "to_currency"]}}, {"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "How much is 250.50 Swiss francs in euros?"}], "expect": {"calls": [{"name": "convert_currency", "arguments": {"type": "object", "properties": {"amount": {"type": "number", "minimum": 250.49, "maximum": 250.51}, "from_currency": {"type": "string", "pattern": "(?i)^chf$"}, "to_currency": {"type": "string", "pattern": "(?i)^eur$"}}, "required": ["amount", "from_currency", "to_currency"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "convert_currency", "arguments": {"amount": 250.5, "from_currency": "CHF", "to_currency": "EUR"}}]}}
{"id": "tools-014", "title": "Anthropic route: single call", "api": "anthropic", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "What's the weather in Berlin right now?"}], "expect": {"calls": [{"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^berlin\\b"}, "unit": {"enum": ["celsius", "fahrenheit"]}}, "required": ["city"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "get_weather", "arguments": {"city": "Berlin"}}]}}
{"id": "tools-015", "title": "Anthropic route: parallel calls", "api": "anthropic", "tools": [{"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "Is it warmer in Cairo or in Nairobi right now?"}], "expect": {"calls": [{"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^cairo\\b"}, "unit": {"enum": ["celsius", "fahrenheit"]}}, "required": ["city"], "additionalProperties": false}}, {"name": "get_weather", "arguments": {"type": "object", "properties": {"city": {"type": "string", "pattern": "(?i)^nairobi\\b"}, "unit": {"enum": ["celsius", "fahrenheit"]}}, "required": ["city"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "get_weather", "arguments": {"city": "Cairo"}}, {"name": "get_weather", "arguments": {"city": "Nairobi"}}]}}
{"id": "tools-016", "title": "Anthropic route: nested arguments", "api": "anthropic", "tools": [{"name": "schedule_meeting", "description": "Schedule a meeting in the shared calendar.", "parameters": {"type": "object", "properties": {"title": {"type": "string"}, "start": {"type": "object", "properties": {"date": {"type": "string", "description": "YYYY-MM-DD"}, "time": {"type": "string", "description": "HH:MM, 24-hour clock"}}, "required": ["date", "time"]}, "duration_minutes": {"type": "integer"}, "attendees": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "email": {"type": "string"}}, "required": ["name", "email"]}}}, "required": ["title", "start", "duration_minutes", "attendees"]}}], "messages": [{"role": "user", "content": "Schedule 'Sprint planning' on 2027-01-11 at 09:00 for 60 minutes with Chen Wei (chen@example.com)."}], "expect": {"calls": [{"name": "schedule_meeting", "arguments": {"type": "object", "properties": {"title": {"type": "string", "pattern": "(?i)^sprint planning$"}, "start": {"type": "object", "properties": {"date": {"const": "2027-01-11"}, "time": {"type": "string", "pattern": "^09:00(:00)?$"}}, "required": ["date", "time"], "additionalProperties": false}, "duration_minutes": {"const": 60}, "attendees": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "properties": {"name": {"type": "string", "pattern": "(?i)chen"}, "email": {"const": "chen@example.com"}}, "required": ["name", "email"]}}}, "required": ["title", "start", "duration_minutes", "attendees"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "schedule_meeting", "arguments": {"title": "Sprint planning", "start": {"date": "2027-01-11", "time": "09:00"}, "duration_minutes": 60, "attendees": [{"name": "Chen Wei", "email": "chen@example.com"}]}}]}}
{"id": "tools-017", "title": "Anthropic route: no call needed", "api": "anthropic", "tools": [{"name": "ssh_exec", "description": "Run a command on a remote host over SSH. Known hosts: nas, router, printer.", "parameters": {"type": "object", "properties": {"host": {"type": "string", "enum": ["nas", "router", "printer"]}, "command": {"type": "string"}}, "required": ["host", "command"]}}, {"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Paris"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit (default celsius)"}}, "required": ["city"]}}], "messages": [{"role": "user", "content": "In one sentence, what does the Unix command pwd do?"}], "expect": {"calls": [], "text": [{"check": "regex", "pattern": "(?i)(current|working) director"}]}, "reference": {"calls": [], "text": "pwd prints the current working directory."}}
{"id": "tools-018", "title": "Anthropic route: multi-turn, the next call uses the tool result", "api": "anthropic", "tools": [{"name": "search_knowledge_base", "description": "Search the team's knowledge base of documents and return the best matching passages with their file names.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}, "k": {"type": "integer", "description": "Number of passages, 1 to 10"}}, "required": ["query"]}}, {"name": "read_file", "description": "Read a text file, or only a range of its lines (1-based, inclusive).", "parameters": {"type": "object", "properties": {"path": {"type": "string", "description": "Path of the file"}, "start_line": {"type": "integer", "description": "First line to return"}, "end_line": {"type": "integer", "description": "Last line to return"}}, "required": ["path"]}}], "messages": [{"role": "user", "content": "Find our backup retention policy and tell me how many daily snapshots we keep. Read the source file if the search result does not say."}, {"role": "assistant", "content": [{"type": "tool_use", "id": "toolu_01", "name": "search_knowledge_base", "input": {"query": "backup retention policy"}}]}, {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_01", "content": "[{\"file\": \"docs/backup-policy.md\", \"line\": 22, \"snippet\": \"## Retention\"}]"}]}], "expect": {"calls": [{"name": "read_file", "arguments": {"type": "object", "properties": {"path": {"type": "string", "pattern": "^(\\./)?docs/backup-policy\\.md$"}, "start_line": {"type": "integer"}, "end_line": {"type": "integer"}}, "required": ["path"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "read_file", "arguments": {"path": "docs/backup-policy.md"}}]}}
{"id": "tools-019", "title": "Anthropic route: remote host versus workstation", "api": "anthropic", "tools": [{"name": "run_command", "description": "Run a shell command on this workstation and return its output.", "parameters": {"type": "object", "properties": {"command": {"type": "string", "description": "The command line to run"}, "cwd": {"type": "string", "description": "Working directory"}, "timeout_s": {"type": "integer", "description": "Time limit in seconds"}}, "required": ["command"]}}, {"name": "ssh_exec", "description": "Run a command on a remote host over SSH. Known hosts: nas, router, printer.", "parameters": {"type": "object", "properties": {"host": {"type": "string", "enum": ["nas", "router", "printer"]}, "command": {"type": "string"}}, "required": ["host", "command"]}}, {"name": "read_file", "description": "Read a text file, or only a range of its lines (1-based, inclusive).", "parameters": {"type": "object", "properties": {"path": {"type": "string", "description": "Path of the file"}, "start_line": {"type": "integer", "description": "First line to return"}, "end_line": {"type": "integer", "description": "Last line to return"}}, "required": ["path"]}}], "messages": [{"role": "user", "content": "Check the ZFS pool status on the nas."}], "expect": {"calls": [{"name": "ssh_exec", "arguments": {"type": "object", "properties": {"host": {"const": "nas"}, "command": {"type": "string", "pattern": "^(sudo )?zpool status\\b"}}, "required": ["host", "command"], "additionalProperties": false}}]}, "reference": {"calls": [{"name": "ssh_exec", "arguments": {"host": "nas", "command": "zpool status"}}]}}
{"id": "tools-020", "title": "Anthropic route: workstation command with a working directory", "api": "anthropic", "tools": [{"name": "run_command", "description": "Run a shell command on this workstation and return its output.", "parameters": {"type": "object", "properties": {"command": {"type": "string", "description": "The command line to run"}, "cwd": {"type": "string", "description": "Working directory"}, "timeout_s": {"type": "integer", "description": "Time limit in seconds"}}, "required": ["command"]}}, {"name": "ssh_exec", "description": "Run a command on a remote host over SSH. Known hosts: nas, router, printer.", "parameters": {"type": "object", "properties": {"host": {"type": "string", "enum": ["nas", "router", "printer"]}, "command": {"type": "string"}}, "required": ["host", "command"]}}], "messages": [{"role": "user", "content": "Show the git status of the repository in /srv/app on this workstation."}], "expect": {"calls": [{"name": "run_command", "arguments": {"type": "object", "anyOf": [{"properties": {"command": {"type": "string", "pattern": "^git status\\b"}, "cwd": {"type": "string", "pattern": "^/srv/app/?$"}}, "required": ["command", "cwd"]}, {"properties": {"command": {"type": "string", "pattern": "(cd /srv/app/? *(&&|;) *git status|git -C /srv/app/? status)"}}, "required": ["command"]}]}}]}, "reference": {"calls": [{"name": "run_command", "arguments": {"command": "git status", "cwd": "/srv/app"}}]}}
